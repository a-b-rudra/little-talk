    {
      "sender": "...",
      "reply_delay": 1.2,
      "typing_duration": 1.8,
      "timestamp": "23:46",
      "text": "Why don't you write something similar?"
    },
    {
      "sender": "you",
      "reply_delay": 1.6,
      "typing_duration": 1.1,
      "timestamp": "23:46",
      "text": "Why would I do that?"
    },
    {
      "sender": "...",
      "reply_delay": 3.1,
      "typing_duration": 2.2,
      "timestamp": "23:47",
      "text": "The best kind of magic is no magic at all."
