    {
      "sender": "...",
      "reply_delay": 0.6,
      "typing_duration": 1.8,
      "timestamp": "23:43",
      "text": "having this conversation right now."
    },
    {
      "sender": "...",
      "reply_delay": 1.1,
      "typing_duration": 3.4,
      "timestamp": "23:44",
      "text": "For a change, it felt good to read and not worry about the consequences."
    },
    {
      "sender": "you",
      "reply_delay": 1.9,
      "typing_duration": 1.4,
      "timestamp": "23:44",
      "text": "But that achieves nothing."
    },
    {
      "sender": "you",
      "reply_delay": 0.6,
      "typing_duration": 1.6,
      "timestamp": "23:44",
      "text": "Why would you read such a story?"
    },
    {
      "sender": "...",
      "reply_delay": 2.4,
      "typing_duration": 1.7,
      "timestamp": "23:45",
      "text": "Maybe that's what was different."
    },
    {
      "sender": "...",
      "reply_delay": 0.8,
      "typing_duration": 2.3,
      "timestamp": "23:45",
      "text": "It didn't bother to burden me with the characters."
    },
    {
      "sender": "...",
      "reply_delay": 0.7,
      "typing_duration": 2.0,
      "timestamp": "23:45",
      "text": "The conversation, meaningless as it may be,"
